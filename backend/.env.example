# Copy this file to .env and fill in real values before deploying.

# Default: local SQLite, zero setup, good for a judge-demo laptop.
DATABASE_URL=sqlite:///./ransomware_ews.db

# For MySQL instead:
# DATABASE_URL=mysql+pymysql://ews_user:ews_password@localhost:3306/ransomware_ews

JWT_SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

CERT_IN_POC_EMAIL=socadmin@institution.edu.in
